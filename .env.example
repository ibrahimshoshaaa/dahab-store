# Turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Admin
ADMIN_USER=admin
ADMIN_PASS=change_this_password
ADMIN_TOKEN_SECRET=change_this_to_a_long_random_secret
ADMIN_TOKEN_TTL_SECONDS=28800

# Cloudinary (used by /api/admin/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: only needed if the frontend is deployed separately.
# For a single Vercel deployment, leave this empty/unset.
NEXT_PUBLIC_API_URL=

# Public production site URL (SEO/canonical/sitemap)
NEXT_PUBLIC_SITE_URL=https://www.ninetypay.com
